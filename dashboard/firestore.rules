rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isActiveUser() {
      return isAuthenticated() 
        && (
          (exists(/databases/$(database)/documents/users/$(request.auth.token.email)) 
           && get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.isActive == true)
          ||
          (exists(/databases/$(database)/documents/users/$(request.auth.token.email.lower())) 
           && get(/databases/$(database)/documents/users/$(request.auth.token.email.lower())).data.isActive == true)
        );
    }

    function isManagerOrOwner() {
      return isActiveUser() 
        && (
          (exists(/databases/$(database)/documents/users/$(request.auth.token.email)) 
           && (get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'Owner' 
               || get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'Manager'))
          ||
          (exists(/databases/$(database)/documents/users/$(request.auth.token.email.lower())) 
           && (get(/databases/$(database)/documents/users/$(request.auth.token.email.lower())).data.role == 'Owner' 
               || get(/databases/$(database)/documents/users/$(request.auth.token.email.lower())).data.role == 'Manager'))
        );
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow update: if isManagerOrOwner() || (isAuthenticated() && request.auth.token.email == userId);
      allow create, delete: if isManagerOrOwner();
    }

    match /settings/{docId} {
      // General settings (shop, dropdowns, loyalty) are readable by active users
      // SMS configuration credentials are strictly locked to Manager or Owner
      allow read: if (docId == 'sms') ? isManagerOrOwner() : isActiveUser();
      allow write: if isManagerOrOwner();
    }

    match /notifications/{notifId} {
      allow read, write: if isActiveUser();
    }

    match /customers/{customerId} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser();
      allow delete: if isManagerOrOwner();
    }
    
    match /inventory/{itemId} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser();
      allow delete: if isManagerOrOwner();
    }

    match /transactions/{transactionId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser();
      allow update, delete: if isManagerOrOwner();
    }

    match /expenses/{expenseId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser();
      allow update, delete: if isManagerOrOwner();
    }

    match /suppliers/{supplierId} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser();
      allow delete: if isManagerOrOwner();
    }

    match /loans/{loanId} {
      allow read: if isActiveUser();
      allow create, update: if isManagerOrOwner();
      allow delete: if isManagerOrOwner();
    }

    match /mechanics/{mechanicId} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser();
      allow delete: if isManagerOrOwner();
    }

    match /attendance/{attendanceId} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser();
      allow delete: if isManagerOrOwner();
    }

    match /payroll/{payrollId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isManagerOrOwner();
    }

    match /salaryConfigs/{userId} {
      allow read: if isActiveUser();
      allow write: if isManagerOrOwner();
    }
  }
}
