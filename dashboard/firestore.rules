rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isActiveUser() {
      return isAuthenticated() 
        && exists(/databases/$(database)/documents/users/$(request.auth.token.email)) 
        && get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.isActive == true;
    }

    function isManagerOrOwner() {
      return isActiveUser() 
        && (get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'Owner' 
            || get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'Manager');
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      // Regular users can only update non-sensitive profile fields (e.g. fcmToken, avatar).
      // They are strictly forbidden from modifying 'role' or 'isActive' to prevent self-privilege escalation.
      allow update: if isManagerOrOwner() || (
        isActiveUser() && 
        request.auth.token.email == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isActive'])
      );
      allow create, delete: if isManagerOrOwner();
    }

    match /settings/{docId} {
      // General settings (shop, dropdowns, loyalty) are readable by active users
      // SMS and Telegram configuration credentials are strictly locked to Manager or Owner
      allow read: if (docId == 'sms' || docId == 'telegram') ? isManagerOrOwner() : isActiveUser();
      allow write: if isManagerOrOwner();
    }

    match /notifications/{notifId} {
      allow read, write: if isActiveUser();
    }

    match /customers/{customerId} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser();
      allow delete: if isManagerOrOwner();
    }
    
    match /inventory/{itemId} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser();
      allow delete: if isManagerOrOwner();
    }

    match /transactions/{transactionId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser();
      allow update, delete: if isManagerOrOwner();
    }

    match /expenses/{expenseId} {
      allow read, write: if isManagerOrOwner();
    }

    match /suppliers/{supplierId} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser();
      allow delete: if isManagerOrOwner();
    }

    match /loans/{loanId} {
      allow read, write: if isManagerOrOwner();
    }

    match /mechanics/{mechanicId} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser();
      allow delete: if isManagerOrOwner();
    }

    match /attendance/{attendanceId} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser();
      allow delete: if isManagerOrOwner();
    }

    match /payroll/{payrollId} {
      allow read: if isManagerOrOwner() || (isActiveUser() && resource.data.staffEmail == request.auth.token.email);
      allow create, update, delete: if isManagerOrOwner();
    }

    match /salaryConfigs/{userId} {
      allow read: if isManagerOrOwner() || (isActiveUser() && request.auth.token.email == userId);
      allow write: if isManagerOrOwner();
    }
  }
}
